# Chrome Web Store publishing credentials — copy to `.env.publish` and fill in.
# `.env.publish` is gitignored; NEVER commit real values.
# How to obtain these: see extension/PUBLISH_SETUP.md (one-time, ~5 min).

# Already known — this is the live extension's item ID:
WEBSTORE_EXTENSION_ID=pjagoopeamgadpgmlnjmdbplhfejeecb

# From your Google Cloud OAuth 2.0 client (Desktop app type):
WEBSTORE_CLIENT_ID=
WEBSTORE_CLIENT_SECRET=

# Long-lived token from the one-time authorization flow:
WEBSTORE_REFRESH_TOKEN=
