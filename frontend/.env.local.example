NEXT_PUBLIC_API_URL=https://api.writingtwinai.com
NEXT_PUBLIC_POSTHOG_KEY=phc_your_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=price_...
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY=price_...
NEXT_PUBLIC_STRIPE_PRICE_TEAM_MONTHLY=price_...

# Supabase (server-side only — never use NEXT_PUBLIC_ for service role key)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# CTA / Install button (single source of truth — used only in InstallButton.tsx)
NEXT_PUBLIC_CHROME_STORE_URL=https://chromewebstore.google.com/detail/writing-twin-ai/EXTENSION_ID
# "waitlist" shows email-capture modal; "install" links to Chrome Web Store
NEXT_PUBLIC_CTA_MODE=waitlist
